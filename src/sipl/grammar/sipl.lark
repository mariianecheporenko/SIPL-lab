// SIPL grammar. Arithmetic precedence: * before + and -; operators associate left.

// SIPL grammar (LALR(1)).
//
// Disambiguation rules:
//   1. `;` is the lowest-precedence construct. The branches of `if` and the
//      body of `while` are a single statement; to put several statements
//      there, wrap them in `begin ... end`. Hence
//          while C do A; B   means   (while C do A); B
//   2. Arithmetic: `*` binds tighter than `+` and `-`; all are left-associative.
//   3. Boolean: `~` binds tighter than `|`; `|` is left-associative.
//   4. Keywords, names and integers must not be glued to neighbouring letters
//      or digits (`1end`, `beginX`, `Xend` are rejected).
//
// Terminals starting with `_` are filtered out of the parse tree.

start: _BEGIN statement _END

?statement: sequence
sequence: simple (";" simple)*

?simple: assignment
       | if_statement
       | while_statement
       | block
       | _SKIP                          -> skip_statement

assignment: NAME ":=" arithmetic
if_statement: _IF boolean _THEN simple _ELSE simple
while_statement: _WHILE boolean _DO simple
block: _BEGIN statement _END

?arithmetic: sum
?sum: product
    | sum "+" product                  -> add
    | sum "-" product                  -> subtract
?product: atom
        | product "*" atom             -> multiply
?atom: INTEGER                         -> number
     | NAME                            -> variable
     | "(" arithmetic ")"

?boolean: boolean_or
?boolean_or: boolean_atom
           | boolean_or OR boolean_atom -> boolean_or_op
?boolean_atom: comparison
             | "~" boolean_atom        -> boolean_not
             | "(" boolean ")"
comparison: arithmetic "=" arithmetic -> equal
          | arithmetic ">" arithmetic -> greater

OR: "\\/" | "|" | "∨"

_BEGIN: /begin\b/
_END:   /end\b/
_IF:    /if\b/
_THEN:  /then\b/
_ELSE:  /else\b/
_WHILE: /while\b/
_DO:    /do\b/
_SKIP:  /skip\b/

NAME:    /[A-Z]+(?![A-Za-z0-9_])/
INTEGER: /-?[0-9]+(?![A-Za-z0-9_])/

%import common.WS
%ignore WS